// System landscape (C4 Level 1): Velox as a single box + external actors and systems.

views {
  view index {
    title "Landscape"
    description "Top-level context: who uses Velox and which external systems it depends on."
    global style veloxColors
    include *
    style user { color primary }
    style adminOperator { color indigo }
    style velox { color primary }
    autoLayout TopBottom 110 90
  }
}
