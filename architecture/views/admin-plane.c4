// Admin plane: separate deployment for the operator console, plugin registry, runtime config.

views {
  style element.tag = #frontend   { color blue }
  style element.tag = #backend    { color sky }
  style element.tag = #data       { color secondary }
  style element.tag = #adminPlane { color indigo }
  style element.tag = #federation { color green }

  view adminPlaneView of velox {
    title "Admin / Admin Plane"
    description "Operator console, Admin API, plugin registry, runtime config, audit."
    include
      adminOperator,
      velox.adminUI,
      velox.adminAPI,
      velox.adminPostgres,
      velox.kafka,
      objectStorage
    autoLayout TopBottom 110 90
  }
}
