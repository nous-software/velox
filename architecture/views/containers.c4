// Container view (C4 Level 2): all containers inside Velox.
// External systems intentionally excluded — they have their own focused views.

views {
  style element.tag = #frontend   { color blue }
  style element.tag = #backend    { color sky }
  style element.tag = #data       { color secondary }
  style element.tag = #adminPlane { color indigo }
  style element.tag = #federation { color green }

  view containers of velox {
    title "Containers"
    description "Containers inside Velox. External systems shown in dedicated views."
    include velox.*
    autoLayout TopBottom 110 90
  }
}
