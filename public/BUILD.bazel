load("@aspect_rules_js//contrib/nextjs:defs.bzl", "nextjs")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//public:next/package_json.bzl", next_bin = "bin")
load("//bazel:ts_project.bzl", "ts_project")

exports_files(["tsconfig.json"])

npm_link_all_packages()

APP_SRCS = glob(
    ["app/**/*.tsx"],
    allow_empty = True,
)

APP_STYLES = glob(["app/**/*.css"])

PUBLIC_ASSETS = glob(
    ["public/**"],
    allow_empty = True,
)

next_bin.next_binary(
    name = "velox_frontend_bin",
    visibility = ["//visibility:public"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "app",
    srcs = APP_SRCS,
    data = [
        ":node_modules/next",
        ":node_modules/react",
        ":node_modules/tailwindcss",
    ] + APP_STYLES,
    deps = [
        ":node_modules/@types/react",
        ":node_modules/next",
        ":node_modules/react",
    ],
)

ts_project(
    name = "next.config",
    srcs = ["next.config.ts"],
    data = [":node_modules/next"],
    deps = [
        ":node_modules/@types/node",
        ":node_modules/next",
    ],
)

js_library(
    name = "velox_frontend_lib",
    deps = [
        ":app",
        ":next.config",
        ":node_modules/next",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
)

nextjs(
    name = "velox_frontend",
    srcs = [":velox_frontend_lib"],
    config = "next.config.ts",
    data = PUBLIC_ASSETS + [
        "postcss.config.mjs",
        ":node_modules/@tailwindcss/postcss",
    ],
    next_js_binary = ":velox_frontend_bin",
)
